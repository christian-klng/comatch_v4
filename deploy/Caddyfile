# Reverse-Proxy vor der App: HTTPS mit automatischem Let's-Encrypt-Zertifikat, WebSockets für
# Socket.IO laufen ohne Zusatzkonfiguration mit. DOMAIN kommt aus deploy/.env.
{
	# Keine Zugriffsprotokolle mit IP-Adressen (Datenschutz); Fehler landen weiter im Log.
	log {
		level ERROR
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Sicherheits-Header setzt die App selbst (apps/server/src/lib/security-headers.ts).
	header -Server

	reverse_proxy app:3000
}
