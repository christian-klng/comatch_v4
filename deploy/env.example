# Vorlage für den Produktivbetrieb: kopieren nach deploy/.env (nicht einchecken) und ausfüllen.
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env

# Domain, unter der CoMatch läuft (DNS-A/AAAA-Eintrag auf den Server). Caddy holt das Zertifikat.
DOMAIN=comatch.example.de

# Zufällige Werte, z. B. mit: openssl rand -base64 32
POSTGRES_PASSWORD=
MEDIA_SIGNING_SECRET=

# Selfies liegen in der Datenbank. Optional stattdessen in S3, z. B. Hetzner Object Storage
# (Bucket privat, Zugangsdaten in der Cloud Console). Dann alle Zeilen ausfüllen.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stunden nach Eventende, bis Selfies und Sitzungen gelöscht werden
RETENTION_HOURS=24

# Mailversand für Einladungen und „Passwort vergessen“ (SMTP-Anbieter in der EU).
# Leer: Es gehen keine Mails raus; Einladungslinks gibt man dann von Hand weiter.
# Sonderzeichen in Nutzername und Passwort URL-kodieren (@ wird %40).
# SMTP_URL=smtps://nutzer:passwort@smtp.example.de:465
# MAIL_FROM=CoMatch <noreply@example.de>
SMTP_URL=
MAIL_FROM=

# closed: neue Konten nur per Einladung oder Kommandozeile.
# open: Jede Person kann sich selbst ein Konto anlegen. Braucht den Mailversand oben und die
# hinterlegten Rechtstexte (TERMS_VERSION, siehe COOLIFY.md), sonst startet der Server nicht.
SIGNUP_MODE=closed

# Wie viele Events über alle Konten hinweg gleichzeitig laufen dürfen (Schutz des Servers)
MAX_LIVE_EVENTS=20

# Impressum und Datenschutzerklärung (Pflicht). Adresse mit Komma oder Zeilenumbruch trennen.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_DPO=
