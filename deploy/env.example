# Vorlage für den Produktivbetrieb: kopieren nach deploy/.env (nicht einchecken) und ausfüllen.
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env

# Domain, unter der CoMatch läuft (DNS-A/AAAA-Eintrag auf den Server). Caddy holt das Zertifikat.
DOMAIN=comatch.example.de

# Zufällige Werte, z. B. mit: openssl rand -base64 32
POSTGRES_PASSWORD=
MEDIA_SIGNING_SECRET=

# Hetzner Object Storage (Bucket in Falkenstein, Zugangsdaten in der Cloud Console)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stunden nach Eventende, bis Selfies und Sitzungen gelöscht werden
RETENTION_HOURS=24

# Impressum und Datenschutzerklärung (Pflicht). Adresse mit Komma oder Zeilenumbruch trennen.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_DPO=
