# Kopieren nach .env und bei Bedarf anpassen. Nur für die lokale Entwicklung.

NODE_ENV=development
API_PORT=3000
# Postgres aus docker-compose.yml (Host-Port 54340, damit lokale Postgres-Instanzen nicht kollidieren)
DATABASE_URL=postgres://comatch:comatch@localhost:54340/comatch
# Basis-URL, unter der Teilnehmende das Event erreichen (für QR-Codes)
PUBLIC_BASE_URL=http://localhost:5173

# Bild-Speicher für Selfies: lokal RustFS aus docker-compose.yml (Host-Port 9040),
# in Produktion Hetzner Object Storage
S3_ENDPOINT=http://localhost:9040
S3_REGION=fsn1
S3_BUCKET=comatch-selfies
S3_ACCESS_KEY_ID=comatch
S3_SECRET_ACCESS_KEY=comatch-dev-secret

# Admin-Konto, das `npm run db:seed` anlegt (nur lokale Testwerte)
SEED_ADMIN_EMAIL=admin@comatch.local
SEED_ADMIN_PASSWORD=comatch-dev-123
